# Copy this file to secrets.toml and fill in your real values.
# NEVER commit secrets.toml to version control.

GROQ_API_KEY        = "gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GMAIL_ADDRESS       = "your.gmail@gmail.com"
GMAIL_APP_PASSWORD  = "xxxx xxxx xxxx xxxx"
NOTIFICATION_EMAIL  = "recipient@example.com"
GOOGLE_SHEET_ID     = "1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms"

# Paste the full contents of your Google service account JSON here.
# In Streamlit Cloud, add each field individually under [gcp_service_account].
[gcp_service_account]
type                        = "service_account"
project_id                  = "your-gcp-project-id"
private_key_id              = "key-id-hex-string"
private_key                 = "-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n"
client_email                = "smartinvoice@your-gcp-project-id.iam.gserviceaccount.com"
client_id                   = "123456789012345678901"
auth_uri                    = "https://accounts.google.com/o/oauth2/auth"
token_uri                   = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url        = "https://www.googleapis.com/robot/v1/metadata/x509/smartinvoice%40your-gcp-project-id.iam.gserviceaccount.com"
